{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Яндекс Музыка",
  "version": "0.2.0",
  "identifier": "com.tbesa.ymusic",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Яндекс Музыка",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: http: https: data: blob:; img-src * 'self' data: https: http: blob:; media-src * 'self' data: https: http: blob:; connect-src * 'self' data: https: http:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
